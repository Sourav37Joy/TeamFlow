# MongoDB must be a replica set for Prisma transactions (D-12).
# Port 27018, not the default 27017, so this never collides with a locally installed
# MongoDB service running as a standalone.
DATABASE_URL="mongodb://localhost:27018/teamflow?replicaSet=rs0"

# Signs the session cookie. Replace before any deployment.
SESSION_SECRET="change-me-in-production"

# The single timezone in which "today" is resolved for every derived figure (D-07).
ORG_TIMEZONE="UTC"

PORT=3000
