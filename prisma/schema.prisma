generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PROJECT_MANAGER
  ADMINISTRATOR
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  displayName  String
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
}

model Skill {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
}

model Role {
  id   String @id @default(auto()) @map("_id") @db.ObjectId
  name String @unique
}

type EmployeeSkill {
  skillId String @db.ObjectId
  rating  Int
}

model Employee {
  id                   String          @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  roleTitle            String
  totalCapacityPercent Int             @default(100)
  skills               EmployeeSkill[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([name])
}

model Project {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  status    ProjectStatus
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

model RoleRequirement {
  id              String @id @default(auto()) @map("_id") @db.ObjectId
  projectId       String @db.ObjectId
  roleId          String @db.ObjectId
  requiredSkillId String @db.ObjectId
  headcount       Int

  @@unique([projectId, roleId])
  @@index([projectId])
}

model Assignment {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  employeeId              String   @db.ObjectId
  projectId               String   @db.ObjectId
  roleId                  String   @db.ObjectId
  allocationPercent       Int
  startDate               String
  endDate                 String
  predecessorAssignmentId String?  @db.ObjectId
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  createdByUserId         String   @db.ObjectId
  updatedByUserId         String   @db.ObjectId

  @@index([employeeId, startDate, endDate])
  @@index([projectId, roleId, startDate, endDate])
}

model Replacement {
  id                    String   @id @default(auto()) @map("_id") @db.ObjectId
  outgoingAssignmentId  String?  @db.ObjectId
  incomingAssignmentId  String   @db.ObjectId
  outgoingEmployeeId    String   @db.ObjectId
  effectiveDate         String
  performedByUserId     String   @db.ObjectId
  performedAt           DateTime @default(now())

  @@index([incomingAssignmentId])
  @@index([outgoingEmployeeId])
}
